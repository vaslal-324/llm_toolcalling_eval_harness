# Copy to .env (cp .env.example .env) and keep ONE option uncommented.
# Options A and B run in the cloud: nothing is downloaded to your laptop.

# Option A (default): Groq free tier -> key from https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_MIN_INTERVAL_S=2

# Option B: Google Gemini free tier -> key from https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza_your_key_here
# LLM_MODEL=gemini-3.8-flash
# LLM_MIN_INTERVAL_S=6

# Option C: Ollama on your own machine (downloads the model, ~2-5 GB)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_MIN_INTERVAL_S=0

# Option D: Hugging Face Inference Providers (needs purchased credits or a PRO plan)
# Token: https://huggingface.co/settings/tokens -> fine-grained, "Make calls to Inference Providers"
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_your_key_here
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MIN_INTERVAL_S=0

# Model names change over time. If you get "model not found", pick a current model
# that supports tool use / function calling from the provider's model list.
